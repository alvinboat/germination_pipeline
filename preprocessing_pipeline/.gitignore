# Capture data: hundreds of GB over the collection, never versioned. The folder
# skeleton IS versioned, via a .gitkeep in each -- process.py creates the
# per-day/dish/side subfolders, but raw_image/ has to exist for eBUS Player to
# save into before anything has run.
raw_image/*
!raw_image/.gitkeep

preview/*
!preview/.gitkeep

transmittance_images/*
!transmittance_images/.gitkeep

reflectance_images/*
!reflectance_images/.gitkeep

raw_binaries/*
!raw_binaries/transmittance_images/
!raw_binaries/reflectance_images/
raw_binaries/transmittance_images/*
!raw_binaries/transmittance_images/.gitkeep
raw_binaries/reflectance_images/*
!raw_binaries/reflectance_images/.gitkeep

# Calibration captures: large binaries, and .cache/ is derived from them.
**/calibration/**/*.bin
**/calibration/**/*.npy
**/calibration/.cache/

# Derived from the corrected cubes by grid_index.py; regenerate, do not version.
grid_view/

.venv/
__pycache__/
*.pyc
